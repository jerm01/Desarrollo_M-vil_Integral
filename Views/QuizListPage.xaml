<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ODSQuizApp.Views.QuizListPage"
             Title="Lista de Quizzes">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="10">

                <Label Text="Lista de Quizzes"
                       FontSize="Large"
                       FontAttributes="Bold"
                       TextColor="#B19CD9" />

                <Button Text="Crear Nuevo Quiz"
                        BackgroundColor="#B19CD9"
                        TextColor="Black"
                        Clicked="OnCreateQuizClicked" />

                <CollectionView x:Name="QuizCollectionView"
                                IsGrouped="True"
                                ItemsSource="{Binding GroupedQuizzes}"
                                SelectionMode="None">

                    <!-- Encabezado de grupo -->
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#800080"
                                   CornerRadius="5"
                                   Padding="5">
                                <Label Text="{Binding OdsName}"
                                       TextColor="White"
                                       FontSize="Medium"
                                       FontAttributes="Bold" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <!-- Plantilla de item -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="Black"
                                   BorderColor="Gray"
                                   CornerRadius="10"
                                   Padding="10"
                                   Margin="5">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Button Text="Editar"
                                                BackgroundColor="#B19CD9"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnEditQuizClicked" />
                                        <Button Text="Ver Preguntas"
                                                BackgroundColor="#B19CD9"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnViewQuestionsClicked" />
                                        <Button Text="Eliminar"
                                                BackgroundColor="#B19CD9"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnDeleteQuizClicked" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Volver al Inicio"
                        BackgroundColor="DodgerBlue"
                        TextColor="White"
                        Clicked="OnBackToMainPageClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
