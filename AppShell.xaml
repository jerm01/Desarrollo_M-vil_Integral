<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="ODSQuizApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ODSQuizApp.Views;assembly=ODSQuizApp"
    Shell.FlyoutBehavior="Disabled">

    <!-- Vista inicial al abrir la app -->
    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent
        Title="Preguntas"
        Route="QuestionsPage"
        ContentTemplate="{DataTemplate views:QuestionsPage}" />
    <ShellContent
        Title="Pregunta"
        Route="QuestionFormPage"
        ContentTemplate="{DataTemplate views:QuestionFormPage}" />
    <ShellContent
        Title="Quizzes"
        Route="QuizListPage"
        ContentTemplate="{DataTemplate views:QuizListPage}" />
    <ShellContent
        Title="Editar Quiz"
        Route="QuizEditorPage"
        ContentTemplate="{DataTemplate views:QuizEditorPage}" />
    <ShellContent
        Title="Usuarios"
        Route="UserListPage"
        ContentTemplate="{DataTemplate views:UserListPage}" />
    <ShellContent
        Title="Nuevo Usuario"
        Route="UserFormPage"
        ContentTemplate="{DataTemplate views:UserFormPage}" />

</Shell>
